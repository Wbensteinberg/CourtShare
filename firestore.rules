rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isParticipant() {
      return signedIn()
        && request.auth.uid in resource.data.participantIds;
    }

    function courtOwnerMutableFields() {
      return [
        "name",
        "location",
        "address",
        "accessInstructions",
        "checkInType",
        "checkInInstructions",
        "price",
        "description",
        "surface",
        "indoor",
        "amenities",
        "parkingSpaces",
        "spaceGreatFor",
        "maxGuests",
        "speakersPolicy",
        "quietHoursStart",
        "quietHoursEnd",
        "houseRules",
        "additionalRules",
        "imageUrl",
        "imageUrls",
        "bookableStatus",
        "numberOfCourts",
        "maxAdvanceBookingDays",
        "blockedDates",
        "blockedTimes",
        "alwaysBlockedTimes",
        "alwaysBlockedTimesByDay",
        "courtSpecificAlwaysBlockedTimes",
        "courtSpecificAlwaysBlockedTimesByDay",
        "latitude",
        "longitude",
        "draftSavedAt",
        "publishedAt",
        "updatedAt"
      ];
    }

    function courtOwnerCreatableFields() {
      return [
        "name",
        "location",
        "address",
        "accessInstructions",
        "checkInType",
        "checkInInstructions",
        "price",
        "description",
        "surface",
        "indoor",
        "amenities",
        "parkingSpaces",
        "spaceGreatFor",
        "maxGuests",
        "speakersPolicy",
        "quietHoursStart",
        "quietHoursEnd",
        "houseRules",
        "additionalRules",
        "imageUrl",
        "imageUrls",
        "bookableStatus",
        "numberOfCourts",
        "maxAdvanceBookingDays",
        "blockedDates",
        "blockedTimes",
        "alwaysBlockedTimes",
        "alwaysBlockedTimesByDay",
        "courtSpecificAlwaysBlockedTimes",
        "courtSpecificAlwaysBlockedTimesByDay",
        "latitude",
        "longitude",
        "draftSavedAt",
        "publishedAt",
        "updatedAt",
        "ownerId",
        "ownerStripeAccountStatus",
        "createdAt"
      ];
    }

    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == request.auth.uid
        && (!("isOwner" in request.resource.data) || request.resource.data.isOwner == false)
        && request.resource.data.keys().hasOnly([
          "uid",
          "email",
          "displayName",
          "bio",
          "profileImageUrl",
          "isOwner",
          "createdAt",
          "updatedAt",
          "ownerListingWaiverVersionAccepted",
          "ownerListingWaiverAcceptedAt",
          "playerBookingWaiverVersionAccepted",
          "playerBookingWaiverAcceptedAt"
        ]);
      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "displayName",
          "bio",
          "profileImageUrl",
          "updatedAt",
          "ownerListingWaiverVersionAccepted",
          "ownerListingWaiverAcceptedAt",
          "playerBookingWaiverVersionAccepted",
          "playerBookingWaiverAcceptedAt"
        ])
        && (!("displayName" in request.resource.data) || request.resource.data.displayName.size() <= 100)
        && (!("bio" in request.resource.data) || request.resource.data.bio.size() <= 500);
      allow delete: if false;
    }

    match /courts/{courtId} {
      allow read: if resource.data.bookableStatus == "active"
        || signedIn();
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.bookableStatus in ["draft", "active"]
        && request.resource.data.ownerStripeAccountStatus == "inactive"
        && request.resource.data.keys().hasOnly(courtOwnerCreatableFields());
      allow update: if signedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.bookableStatus in ["draft", "active"]
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
          courtOwnerMutableFields()
        );
      allow delete: if signedIn()
        && resource.data.ownerId == request.auth.uid
        && resource.data.bookableStatus == "draft";
    }

    match /bookings/{bookingId} {
      allow read: if signedIn()
        && (resource.data.userId == request.auth.uid
          || resource.data.ownerId == request.auth.uid);
      allow create, update, delete: if false;
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    match /conversations/{conversationId} {
      allow read: if isParticipant();
      allow create: if false;
      allow update: if isParticipant()
        && request.resource.data.participantIds == resource.data.participantIds
        && request.resource.data.playerId == resource.data.playerId
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.courtId == resource.data.courtId
        && request.resource.data.bookingId == resource.data.bookingId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "unreadBy",
          "updatedAt",
          "playerName",
          "ownerName"
        ]);
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
        allow create: if false;
        allow update, delete: if false;
      }
    }

    match /bookingSlotLocks/{lockId} {
      allow read, write: if false;
    }

    match /securityAuditLogs/{logId} {
      allow read, write: if false;
    }
  }
}
