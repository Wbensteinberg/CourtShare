rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isParticipant() {
      return signedIn()
        && request.auth.uid in resource.data.participantIds;
    }

    function isIncomingParticipant() {
      return signedIn()
        && request.auth.uid in request.resource.data.participantIds;
    }

    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn() && request.auth.uid == userId;
      allow update: if signedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    match /courts/{courtId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if signedIn()
        && resource.data.ownerId == request.auth.uid;
    }

    match /bookings/{bookingId} {
      allow read: if signedIn()
        && (resource.data.userId == request.auth.uid
          || resource.data.ownerId == request.auth.uid
          || get(/databases/$(database)/documents/courts/$(resource.data.courtId)).data.ownerId == request.auth.uid);
      allow create, update, delete: if false;
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    match /conversations/{conversationId} {
      allow read: if isParticipant();
      allow create: if isIncomingParticipant();
      allow update: if isParticipant()
        && request.resource.data.participantIds == resource.data.participantIds
        && request.resource.data.playerId == resource.data.playerId
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.courtId == resource.data.courtId
        && request.resource.data.bookingId == resource.data.bookingId;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
        allow create: if signedIn()
          && request.auth.uid == request.resource.data.senderId
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
        allow update, delete: if false;
      }
    }
  }
}
